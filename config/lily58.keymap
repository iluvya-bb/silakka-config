#include <behaviors.dtsi>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// --- LAYER DEFINITIONS ---
#define DVO 0  // Dvorak (Base)
#define QWE 1  // QWERTY (Fallback/Gaming)
#define NAV 2  // Navigation (Vim Arrows + Hyprland)
#define SYM 3  // Symbols (Coding & Numbers)
#define BTL 4  // Bluetooth & System (Renamed to avoid Zephyr crash)

/ {
    // ==============================================================
    // COMBOS (2-Button Logic)
    // ==============================================================
    combos {
        compatible = "zmk,combos";

        // Press A + O together to toggle QWERTY (useful for guests or gaming)
        combo_toggle_qwerty {
            timeout-ms = <50>;
            key-positions = <25 26>; 
            bindings = <&tog QWE>;
        };

        // Press S + Enter (Bottom Right) to access Bluetooth Layer
        combo_bt_layer {
            timeout-ms = <50>;
            key-positions = <34 55>; // 55 is the correct index for padded Enter
            bindings = <&mo BTL>;
        };
    };

    // ==============================================================
    // BEHAVIORS (Home Row Mods & Layer Taps)
    // ==============================================================
    behaviors {
        // hm: Hold for Modifier, Tap for Letter
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        // lt_th: Hold for Layer, Tap for Key (Thumb Optimized)
        lt_th: layer_tap_thumb {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_THUMB";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            flavor = "hold-preferred"; /* Forces layer to activate immediately on hold */
            bindings = <&mo>, <&kp>;
        };
    };

    // ==============================================================
    // KEYMAP (The Padded 58-Key Grid)
    // ==============================================================
    keymap {
		display-name = "DVO";
        compatible = "zmk,keymap";

        // 0: DVORAK (Base with Homerow Mods & Mod-Tap Thumbs)
        default_layer {
            bindings = <
            &kp GRAVE      &kp N1     &kp N2     &kp N3      &kp N4   &kp N5                      &kp N6  &kp N7  &kp N8      &kp N9     &kp N0     &kp BSPC
            &kp EQUAL      &kp P      &kp Y      &kp F       &kp G    &kp COMMA                   &kp DOT &kp C   &kp R       &kp L      &kp SEMI   &kp MINUS 
            &hm LSHFT BSLH &hm LGUI A &hm LALT O &hm LCTRL E &kp U    &kp I                       &kp D   &kp H   &hm RCTRL T &hm RALT N &hm RGUI S &hm RSHFT FSLH 
            &kp CAPS       &kp Q      &kp J      &kp K       &kp X    &kp SQT     &none     &none &kp B   &kp M   &kp W       &kp V      &kp Z      &kp INS
                        &mt LGUI ESC &lt_th NAV SPACE &mt LSHFT TAB &none       &none &mt LCTRL RET &lt_th SYM BSPC &mt LALT DEL
            >;
        };

        // 1: QWERTY
        qwerty_layer {
			display-name = "QWE";
            bindings = <
            &kp GRAVE &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                      &kp N6  &kp N7  &kp N8  &kp N9  &kp N0   &kp BSPC
            &kp TAB   &kp Q   &kp W   &kp E   &kp R   &kp T                       &kp Y   &kp U   &kp I   &kp O   &kp P    &kp MINUS 
            &kp LCTRL &kp A   &kp S   &kp D   &kp F   &kp G                       &kp H   &kp J   &kp K   &kp L   &kp SEMI &kp FSLH 
            &kp LSHFT &kp Z   &kp X   &kp C   &kp V   &kp B       &none     &none &kp N   &kp M   &kp COMMA &kp DOT &kp SQT &kp INS
                                &kp LALT  &kp SPACE  &kp LGUI     &none     &none &kp RET &kp ESC &tog QWE
            >;
        };

        // 2: NAVIGATION
        nav_layer {
			display-name = "NAV";
            bindings = <
            &kp F1     &kp F2       &kp F3          &kp F4      &kp F5     &kp F6             &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
            &trans     &trans       &kp LC(LS(TAB)) &kp LC(TAB) &trans     &trans             &kp HOME  &kp PG_DN &kp PG_UP &kp END   &kp INS   &trans
            &kp LSHFT  &kp LGUI     &kp LALT        &kp LCTRL   &trans     &trans             &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp COLON &trans
            &trans     &kp LC(Z)    &kp LC(X)       &kp LC(C)   &kp LC(V)  &trans     &none &none &trans    &trans    &trans    &trans    &kp QMARK &trans
                                                &trans       &trans       &trans      &none &none &trans    &trans    &trans
            >;
        };

        // 3: SYMBOLS
        sym_layer {
			display-name = "SYM";
            bindings = <
            &trans    &trans    &trans    &trans    &trans    &trans                      &trans   &trans   &trans   &trans   &trans    &trans
            &kp TILDE &kp LBRC  &kp RBRC  &kp PIPE  &kp AMPS  &kp UNDER                   &trans   &kp N7   &kp N8   &kp N9   &kp PLUS  &kp ASTRK
            &kp GRAVE &kp LPAR  &kp RPAR  &kp DLLR  &kp PRCNT &kp CARET                   &trans   &kp N4   &kp N5   &kp N6   &kp MINUS &kp FSLH
            &trans    &kp LBKT  &kp RBKT  &kp AT    &kp EXCL  &kp HASH      &none   &none &kp N0   &kp N1   &kp N2   &kp N3   &kp EQUAL &kp DOT
                                                &trans    &trans    &trans        &none   &none &trans   &trans   &trans
            >;
        };

        // 4: BLUETOOTH
        btl_layer {
			display-name = "SYS";
            bindings = <
            &bootloader  &ext_power EP_TOG &trans       &trans       &trans       &trans              &trans   &trans     &trans       &trans       &trans     &bt BT_CLR
            &sys_reset   &bt BT_SEL 0      &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4        &trans   &trans     &trans       &trans       &trans     &sys_reset
            &trans       &trans            &trans       &trans       &trans       &trans              &trans   &kp C_PREV &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT &trans
            &trans       &trans            &trans       &trans       &trans       &trans        &none &none &trans   &trans     &kp C_MUTE   &kp C_PP     &trans     &trans
                                                       &trans       &trans       &trans         &none &none &trans   &trans     &trans
            >;
        };

    };
};
