#include <behaviors.dtsi>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// --- LAYER DEFINITIONS ---
#define DVO 0  // Dvorak (Base)
#define QWE 1  // QWERTY (Fallback/Gaming)
#define NAV 2  // Navigation (Vim Arrows + Hyprland)
#define SYM 3  // Symbols (Coding & Numbers)
#define BTL 4  // Bluetooth & System

// --- POSITIONAL HOLD KEY GROUPS (for "timeless" home-row mods) ---
// A left mod only triggers when a RIGHT key/thumb is pressed, and vice versa,
// so same-hand rolls can never misfire a modifier.
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 44 45 46 47 48 49
#define THUMBS 50 51 52 53 54 55 56 57

/ {
    // ==============================================================
    // COMBOS (2-Button Logic)
    // ==============================================================
    combos {
        compatible = "zmk,combos";

        // Press the two INNER top-row keys together (positions 17+18 = ',' + '.'
        // on Dvorak, where QWERTY 'T' + 'Y' sit) to toggle the QWERTY layer.
        combo_toggle_qwerty {
            timeout-ms = <50>;
            key-positions = <17 18>;
            bindings = <&tog QWE>;
        };

        // Press the two OUTERMOST thumb keys together (positions 50+57 = the left
        // Esc/Alt thumb + the right Alt thumb) to reach the Bluetooth/System layer.
        combo_bt_layer {
            timeout-ms = <50>;
            key-positions = <50 57>;
            bindings = <&mo BTL>;
        };
    };

    // ==============================================================
    // BEHAVIORS (Home Row Mods & Layer Taps)
    // ==============================================================
    behaviors {
        // hml: Left-hand home-row mod. Only fires as a modifier if a RIGHT-side
        // key or thumb follows (positional hold) -> no same-hand-roll misfires.
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_LEFT";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release; // allows chaining cross-hand mods (e.g. Ctrl+Shift)
            bindings = <&kp>, <&kp>;
        };

        // hmr: Right-hand home-row mod. Mirror of hml (triggers on LEFT keys/thumbs).
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_RIGHT";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        // lt_th: Hold for Layer, Tap for Key (Thumb Optimized)
        lt_th: layer_tap_thumb {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_THUMB";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            flavor = "hold-preferred"; 
            bindings = <&mo>, <&kp>;
        };
    };

    // ==============================================================
    // KEYMAP (The Padded 58-Key Grid)
    // ==============================================================
    keymap {
        compatible = "zmk,keymap";

        // 0: DVORAK (Base with perfectly aligned Homerow Mods)
        default_layer {
            display-name = "DVO";
            bindings = <
            &kp GRAVE    &kp N1     &kp N2     &kp N3      &kp N4      &kp N5                      &kp N6  &kp N7      &kp N8      &kp N9     &kp N0     &kp DEL
            &kp EQUAL    &kp P      &kp Y      &kp F       &kp G       &kp COMMA                   &kp DOT &kp C       &kp R       &kp L      &kp SEMI   &kp MINUS 
            &kp BSLH     &hml LGUI A &hml LALT O &hml LCTRL E &hml LSHFT U &kp I                    &kp D   &hmr RSHFT H &hmr RCTRL T &hmr RALT N &hmr RGUI S &kp FSLH
            &kp LBKT     &kp Q      &kp J      &kp K       &kp X       &kp SQT     &none     &none &kp B   &kp M       &kp W       &kp V      &kp Z      &kp RBKT
                        &mt LALT ESC &lt_th NAV TAB &mt LSHFT SPACE &none       &none &mt LCTRL RET &lt_th SYM BSPC &kp RALT
            >;
        };

        // 1: QWERTY (No Homerow mods to prevent gaming lag/misfires)
        qwerty_layer {
            display-name = "QWE";
            bindings = <
            &kp GRAVE &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                      &kp N6  &kp N7  &kp N8  &kp N9  &kp N0   &kp DEL
            &kp TAB   &kp Q   &kp W   &kp E   &kp R   &kp T                       &kp Y   &kp U   &kp I   &kp O   &kp P    &kp MINUS 
            &kp LCTRL &kp A   &kp S   &kp D   &kp F   &kp G                       &kp H   &kp J   &kp K   &kp L   &kp SEMI &kp FSLH 
            &kp LBKT  &kp Z   &kp X   &kp C   &kp V   &kp B       &none     &none &kp N   &kp M   &kp COMMA &kp DOT &kp SQT &kp RBKT
                                &kp LALT  &kp LSHFT   &kp SPACE    &none     &none &kp RET &kp BSPC &kp RALT
            >;
        };

        // 2: NAVIGATION
        nav_layer {
            display-name = "NAV";
            bindings = <
            &kp F1     &kp F2       &kp F3          &kp F4      &kp F5     &kp F6             &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
            &trans     &trans       &kp LC(LS(TAB)) &kp LC(TAB) &trans     &trans             &kp HOME  &kp PG_DN &kp PG_UP &kp END   &trans    &trans
            // Shift is bound twice on purpose: the outer column keeps the old pinky
            // position, and index-finger 'U' now matches where Shift lives on DVO.
            // Leaving 'U' as &trans made it fall through to &hml LSHFT U, whose
            // require-prior-idle-ms forced a tap mid-chord (Alt+Shift+arrow misfired).
            &kp LSHFT  &kp LGUI     &kp LALT        &kp LCTRL   &kp LSHFT  &trans             &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp COLON &trans
            // Right bottom row = window management, sitting directly under the
            // arrows: same finger, one row down, moves the window instead of the
            // cursor. Each key emits the whole Alt+Shift+arrow chord on its own
            // (Hyprland's `swapwindow`), so it's just NAV thumb + one finger.
            &trans     &kp LC(Z)    &kp LC(X)       &kp LC(C)   &kp LC(V)  &trans     &none &none &kp LA(LS(LEFT)) &kp LA(LS(DOWN)) &kp LA(LS(UP)) &kp LA(LS(RIGHT)) &kp QMARK &trans
                                                &trans       &trans       &trans      &none &none &trans    &trans    &trans
            >;
        };

        // 3: SYMBOLS
        sym_layer {
            display-name = "SYM";
            label = "SYM";
            bindings = <
            &trans    &trans    &trans    &trans    &trans    &trans                      &trans    &trans    &trans    &trans    &trans    &trans
            &trans    &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT                   &kp CARET &kp AMPS  &kp ASTRK &kp MINUS &kp EQUAL &kp PLUS
            &trans    &kp PIPE  &kp LBRC  &kp LBKT  &kp LPAR  &kp LT                      &kp GT    &kp RPAR  &kp RBKT  &kp RBRC  &kp BSLH  &trans
            &trans    &kp UNDER &kp DQT   &kp SQT   &kp GRAVE &kp TILDE     &none   &none &trans    &kp COLON &kp SEMI  &kp QMARK &kp FSLH  &trans
                                                &trans    &trans    &trans        &none   &none &trans    &trans    &trans
            >;
        };

        // 4: BLUETOOTH
        btl_layer {
            display-name = "SYS";
            bindings = <
            &bootloader  &ext_power EP_TOG &trans       &trans       &trans       &trans              &trans   &trans     &trans       &trans       &trans     &bt BT_CLR
            &sys_reset   &bt BT_SEL 0      &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4        &trans   &trans     &trans       &trans       &trans     &sys_reset
            &trans       &trans            &trans       &trans       &trans       &trans              &trans   &kp C_PREV &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT &trans
            &trans       &trans            &trans       &trans       &trans       &trans        &none &none &trans   &trans     &kp C_MUTE   &kp C_PP     &trans     &trans
                                                       &trans       &trans       &trans         &none &none &trans   &trans     &trans
            >;
        };

    };
};
